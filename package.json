{
  "name": "simulateur-actif-saas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "video:render": "remotion render video/index.ts Colombes40 public/film/colombes-40s.mp4 --public-dir=public",
    "video:studio": "remotion studio video/index.ts --public-dir=public",
    "video:render:70": "remotion render video/index.ts Colombes70 public/film/colombes-70s.mp4 --public-dir=public",
    "video:audio": "node scripts/build-sfx.mjs && node scripts/align-captions.mjs && node scripts/build-mix.mjs",
    "video:render:ladder": "remotion render video/index.ts Ladder35 public/film/colombes-ladder.mp4 --public-dir=public",
    "video:render:remains": "remotion render video/index.ts Remains35 public/film/colombes-remains.mp4 --public-dir=public",
    "video:render:built": "remotion render video/index.ts Built70 public/film/colombes-built.mp4 --public-dir=public"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.501",
